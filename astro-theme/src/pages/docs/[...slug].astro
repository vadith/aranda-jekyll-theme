---
import { render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { buildPageMap, getDocsEntries } from '../../lib/pages';

export async function getStaticPaths() {
  const entries = await getDocsEntries();
  return entries
    .filter((entry) => entry.slug !== 'index')
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pageMap = await buildPageMap();
---

<DocsLayout
  title={entry.data.title}
  info={entry.data.info}
  beta={entry.data.beta}
  layoutVariant={entry.data.docLayout}
  sidebar={entry.data.sidebar}
  currentSlug={entry.slug}
  headings={headings}
  pageMap={pageMap}
>
  <Content />
</DocsLayout>
