---
// Recursion de nav a profundidad arbitraria, puerto de _includes/nav.html (Liquid) +
// _data/sidebar.yml. Un mismo componente sirve tanto para el arbol anidado (docsNav) como para el
// catalogo plano (catalogNav) de aranda-docs: un catalogo plano es solo un NavNode[] sin `chapter`.
// Ver rfc/0001-migracion-astro.md, seccion 3.1 y 3.2.
import type { NavNode } from '../data/nav';

interface Props {
  nodes: NavNode[];
  pageMap: Record<string, { title: string; url: string }>;
  currentSlug: string;
}

const { nodes, pageMap, currentSlug } = Astro.props;

function containsCurrent(node: NavNode, slug: string): boolean {
  if ('page' in node) return node.page === slug;
  if ('chapter' in node) return node.pages.some((child) => containsCurrent(child, slug));
  return false;
}
---

<ul class="nav-list">
  {
    nodes.map((node) => {
      if ('chapter' in node) {
        const open = node.pages.some((child) => containsCurrent(child, currentSlug));
        return (
          <li>
            <details open={open}>
              <summary>{node.title}</summary>
              <Astro.self nodes={node.pages} pageMap={pageMap} currentSlug={currentSlug} />
            </details>
          </li>
        );
      }
      if ('url' in node) {
        return (
          <li>
            <a href={node.url} target="_blank" rel="noopener noreferrer" class="nav-link nav-link--external">
              {node.title}
              <span class="arandaIcon-ic_link" aria-hidden="true" />
              <span class="sr-only">(enlace externo)</span>
            </a>
          </li>
        );
      }
      const entry = pageMap[node.page];
      if (!entry) return null;
      const active = node.page === currentSlug;
      return (
        <li>
          <a href={entry.url} class="nav-link" aria-current={active ? 'page' : undefined}>
            {entry.title}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .nav-list {
    list-style: none;
    margin: 0;
    padding-left: 0.75rem;
    font-size: var(--font-sm, 14px);
  }
  .nav-list .nav-list {
    padding-left: 1rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.25rem 0;
    color: var(--text-color, inherit);
  }
  .nav-link {
    display: block;
    padding: 0.25rem 0;
    text-decoration: none;
    color: var(--text-color, inherit);
  }
  .nav-link[aria-current='page'] {
    color: var(--color-brand-default, #4f46e5);
    font-weight: 700;
  }
  .nav-link--external .arandaIcon-ic_link {
    font-size: 0.7em;
    margin-left: 0.25rem;
    vertical-align: middle;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
