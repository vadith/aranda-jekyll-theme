@aranda:registry=https://pkgs.dev.azure.com/arandasoftware/_packaging/release/npm/registry/
registry=https://registry.npmjs.org

; @aranda/aranda.ui@3.0.4 fija react/react-dom/styled-components como peers EXACTOS (sin ^),
; no solo un rango -- npm falla al resolver contra cualquier patch mas nuevo instalado
; (ej. react 19.2.8). El peer de @aranda/aranda.icons ya se corrigio (2026-08-14, ver rfc), pero
; este sigue igual; mismo flag que ya usa el propio repo de aranda.ui para consumirse a si mismo.
legacy-peer-deps=true
